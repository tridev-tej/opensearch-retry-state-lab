POST /retry-job-events/_search
{
  "size": 0,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "batch_id": "exports-20261010"
          }
        },
        {
          "range": {
            "event_time": {
              "lte": "2026-10-10T10:05:00.000+04:00"
            }
          }
        },
        {
          "range": {
            "ingested_at": {
              "lte": "2026-10-10T10:10:00.000+04:00"
            }
          }
        },
        {
          "term": {
            "state": "failed"
          }
        }
      ]
